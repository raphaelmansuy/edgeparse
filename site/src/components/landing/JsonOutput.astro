---
const sampleJson = `{
  "file name": "annual-report.pdf",
  "number of pages": 12,
  "author": "Finance Team",
  "title": "Annual Report 2024",
  "kids": [
    {
      "type": "heading",
      "id": 1,
      "level": "title",
      "heading level": 1,
      "page number": 1,
      "bounding box": [72, 90, 540, 120],
      "font": "Helvetica-Bold",
      "font size": 24.0,
      "content": "Annual Report 2024"
    },
    {
      "type": "paragraph",
      "id": 2,
      "page number": 1,
      "content": "Revenue grew 23% year-over-year..."
    },
    {
      "type": "table",
      "id": 3,
      "page number": 1,
      "rows": [
        {
          "row number": 0,
          "cells": [
            {"col": 0, "content": "Quarter", "is header": true},
            {"col": 1, "content": "Revenue", "is header": true},
            {"col": 2, "content": "Growth", "is header": true}
          ]
        }
      ]
    }
  ]
}`;
---

<section class="json-section" aria-labelledby="json-heading">
  <h2 id="json-heading" class="section-title">Structured Output, Instantly</h2>
  <p class="section-subtitle">
    Feed in any PDF. Get clean, structured JSON — elements, text, tables,
    and full metadata. All in reading order.
  </p>

  <div class="json-columns">
    <div class="json-input">
      <div class="json-label">Input: PDF Document</div>
      <div class="pdf-preview">
        <div class="pdf-placeholder">
          <svg class="pdf-svg-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="48" height="48" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
          <div class="pdf-text">annual-report.pdf</div>
          <div class="pdf-meta">12 pages · 2.4 MB</div>
        </div>
      </div>
    </div>

    <div class="json-arrow" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="32" height="32">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </div>

    <div class="json-output">
      <div class="json-label">Output: Structured JSON</div>
      <pre class="json-code"><code set:text={sampleJson} /></pre>
    </div>
  </div>
</section>

<style>
  .json-section {
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .section-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--ep-text-primary, #111827);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    color: var(--ep-color-muted, #6B7280);
    max-width: 560px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  .json-columns {
    display: grid;
    grid-template-columns: 1fr auto 1.4fr;
    gap: 2rem;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }

  .json-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
    color: var(--ep-color-muted, #6B7280);
  }

  .pdf-preview {
    background: var(--ep-card-bg, white);
    border: 1px solid var(--ep-card-border, #E5E7EB);
    border-radius: 1rem;
    padding: 3rem 2rem;
  }

  .pdf-placeholder {
    text-align: center;
  }

  .pdf-svg-icon {
    color: var(--sl-color-accent, #4F46E5);
    margin-bottom: 1rem;
  }

  .pdf-text {
    font-family: var(--ep-font-mono, monospace);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ep-text-primary, #1F2937);
  }

  .pdf-meta {
    font-size: 0.75rem;
    color: var(--ep-color-muted, #6B7280);
    margin-top: 0.375rem;
  }

  .json-arrow {
    color: var(--sl-color-accent, #4F46E5);
  }

  .json-output {
    text-align: left;
  }

  .json-code {
    background: var(--ep-code-bg, #F3F4F6);
    border: 1px solid var(--ep-card-border, #E5E7EB);
    border-radius: 1rem;
    padding: 1.5rem;
    overflow-x: auto;
    font-family: var(--ep-font-mono, monospace);
    font-size: 0.75rem;
    line-height: 1.6;
    max-height: 400px;
    overflow-y: auto;
    color: var(--ep-text-primary, #1F2937);
  }

  @media (max-width: 768px) {
    .json-columns {
      grid-template-columns: 1fr;
    }
    .json-arrow {
      transform: rotate(90deg);
      text-align: center;
      margin: 0 auto;
    }
    .pdf-preview { padding: 2rem 1.25rem; }
  }

  @media (max-width: 540px) {
    .json-section { padding: 3rem 1rem; }
  }
</style>
