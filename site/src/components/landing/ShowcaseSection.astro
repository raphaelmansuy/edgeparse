---
interface ShowcaseItem {
  icon: string;
  title: string;
  description: string;
  tags: string[];
  href?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: ShowcaseItem[];
}

const {
  title = 'Built for Real-World Use Cases',
  subtitle = 'See how teams use EdgeParse to power production document pipelines.',
  items
} = Astro.props;

const iconPaths: Record<string, string> = {
