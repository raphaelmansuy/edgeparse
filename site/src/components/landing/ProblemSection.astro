---
interface Props {
  title: string;
  subtitle: string;
  cards: Array<{ icon: string; title: string; description: string }>;
}

const { title, subtitle, cards } = Astro.props;

const svgIcons: Record<string, string> = {
  'file-warning': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />',
  'clock': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />',
  'puzzle': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875S10.5 3.089 10.5 4.125c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.4 48.4 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.959.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z" />',
  'server-crash': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m0-10.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />',
};
---

<section class="problem-section" aria-labelledby="problem-heading">
  <div class="problem-container">
    <div class="problem-header">
      <span class="problem-eyebrow">The Challenge</span>
      <h2 id="problem-heading" class="section-title">{title}</h2>
      <p class="section-subtitle">{subtitle}</p>
    </div>
    <div class="problem-grid">
      {cards.map((card, i) => (
        <div class="problem-card" style={`--delay: ${i * 0.1}s`}>
          <div class="problem-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
          <div class="problem-icon-wrap" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="24" height="24" set:html={svgIcons[card.icon] || svgIcons['file-warning']} />
          </div>
          <h3 class="problem-title">{card.title}</h3>
          <p class="problem-desc">{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .problem-section {
    padding: 6rem 1.5rem;
    background: var(--ep-hero-gradient);
    position: relative;
    overflow: hidden;
  }

  .problem-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--sl-color-accent, #4F46E5) 1px, transparent 1px),
      linear-gradient(90deg, var(--sl-color-accent, #4F46E5) 1px, transparent 1px);
    background-size: 80px 80px;
    opacity: 0.015;
    pointer-events: none;
  }

  .problem-container {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }

  .problem-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .problem-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ef4444;
    margin-bottom: 0.75rem;
    padding: 0.3rem 0.75rem;
    background: rgba(239, 68, 68, 0.08);
    border-radius: 999px;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--ep-text-primary, #111827);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--ep-text-secondary, #6B7280);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .problem-card {
    background: var(--ep-card-bg, white);
    border: 1px solid var(--ep-card-border, #E5E7EB);
    border-radius: 1rem;
    padding: 1.75rem 1.25rem;
    text-align: left;
    position: relative;
    transition: all 250ms ease;
    animation: fadeInUp 0.5s ease both;
    animation-delay: var(--delay, 0s);
  }

  .problem-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    border-color: #ef4444;
  }

  .problem-number {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--ep-color-muted, #D1D5DB);
    margin-bottom: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .problem-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 0.625rem;
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .problem-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--ep-text-primary, #111827);
  }

  .problem-desc {
    font-size: 0.82rem;
    color: var(--ep-text-secondary, #6B7280);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .problem-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 540px) {
    .problem-section { padding: 3rem 1rem; }
    .problem-grid { grid-template-columns: 1fr; }
  }
</style>
