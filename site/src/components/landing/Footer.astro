---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer not-content" aria-label="Site footer">
  <div class="footer-inner">

    <!-- Brand column -->
    <div class="footer-brand">
      <a href={base} class="footer-logo" aria-label="EdgeParse home">
        <!-- Icon mark -->
        <svg class="footer-logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" aria-hidden="true" width="28" height="28">
          <defs>
            <linearGradient id="fp-g1" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#818cf8"/>
              <stop offset="100%" stop-color="#6366f1"/>
            </linearGradient>
          </defs>
          <path fill="url(#fp-g1)" fill-rule="evenodd" d="M81 36 64 0 47 36l-1 2-9-10a6 6 0 0 0-9 9l10 10h-2L0 64l36 17h2L28 91a6 6 0 1 0 9 9l9-10 1 2 17 36 17-36v-2l9 10a6 6 0 1 0 9-9l-9-9 2-1 36-17-36-17-2-1 9-9a6 6 0 1 0-9-9l-9 10v-2Zm-17 2-2 5c-4 8-11 15-19 19l-5 2 5 2c8 4 15 11 19 19l2 5 2-5c4-8 11-15 19-19l5-2-5-2c-8-4-15-11-19-19l-2-5Z" clip-rule="evenodd"/>
          <path fill="#4f46e5" opacity="0.7" d="M118 19a6 6 0 0 0-9-9l-3 3a6 6 0 1 0 9 9l3-3Zm-96 4c-2 2-6 2-9 0l-3-3a6 6 0 1 1 9-9l3 3c3 2 3 6 0 9Zm0 82c-2-2-6-2-9 0l-3 3a6 6 0 1 0 9 9l3-3c3-2 3-6 0-9Zm96 4a6 6 0 0 1-9 9l-3-3a6 6 0 1 1 9-9l3 3Z"/>
        </svg>
        <span class="footer-logo-text">Edge<span class="footer-logo-accent">Parse</span></span>
      </a>
      <p class="footer-tagline">
        High-performance PDF extraction for AI agents.<br />
        Rust-native. Zero ML dependencies.
      </p>
      <div class="footer-badges">
        <a href="https://github.com/raphaelmansuy/edgeparse" target="_blank" rel="noopener noreferrer" class="footer-badge" aria-label="Apache 2.0 license">
          Apache 2.0
        </a>
        <a href="https://pypi.org/project/edgeparse/" target="_blank" rel="noopener noreferrer" class="footer-badge footer-badge--accent" aria-label="Available on PyPI">
          PyPI
        </a>
        <a href="https://www.npmjs.com/package/edgeparse" target="_blank" rel="noopener noreferrer" class="footer-badge footer-badge--green" aria-label="Available on npm">
          npm
        </a>
      </div>
    </div>

    <!-- Link columns -->
    <nav class="footer-columns" aria-label="Footer navigation">

      <div class="footer-col">
        <h3 class="footer-col-title">Product</h3>
        <ul class="footer-col-links">
          <li><a href={`${base}getting-started/quick-start-python/`}>Getting Started</a></li>
          <li><a href={`${base}getting-started/quick-start-nodejs/`}>Node.js SDK</a></li>
          <li><a href={`${base}getting-started/quick-start-wasm/`}>WebAssembly</a></li>
          <li><a href={`${base}getting-started/quick-start-cli/`}>CLI</a></li>
          <li><a href={`${base}benchmark/results/`}>Benchmark</a></li>
          <li><a href={`${base}enterprise/`}>Enterprise</a></li>
          <li><a href="/demo/">Live Demo</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-title">Developers</h3>
        <ul class="footer-col-links">
          <li><a href={`${base}getting-started/quick-start-python/`}>Documentation</a></li>
          <li><a href={`${base}concepts/table-extraction/`}>Core Concepts</a></li>
          <li><a href={`${base}api/python/`}>API Reference</a></li>
          <li><a href="https://pypi.org/project/edgeparse/" target="_blank" rel="noopener noreferrer">PyPI</a></li>
          <li><a href="https://www.npmjs.com/package/edgeparse" target="_blank" rel="noopener noreferrer">npm</a></li>
          <li><a href="https://crates.io/crates/edgeparse-cli" target="_blank" rel="noopener noreferrer">crates.io (CLI)</a></li>
          <li><a href="https://crates.io/crates/edgeparse-core" target="_blank" rel="noopener noreferrer">crates.io (Core)</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-title">Community</h3>
        <ul class="footer-col-links">
          <li><a href="https://github.com/raphaelmansuy/edgeparse" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://github.com/raphaelmansuy/edgeparse/issues" target="_blank" rel="noopener noreferrer">Issues</a></li>
          <li><a href="https://github.com/raphaelmansuy/edgeparse/discussions" target="_blank" rel="noopener noreferrer">Discussions</a></li>
          <li><a href={`${base}changelog/`}>Changelog</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-title">Company</h3>
        <ul class="footer-col-links">
          <li><a href="https://elitizon.com/" target="_blank" rel="noopener noreferrer">Elitizon</a></li>
          <li><a href="https://edgequake.com/" target="_blank" rel="noopener noreferrer">EdgeQuake</a></li>
          <li><a href="https://github.com/raphaelmansuy/edgeparse/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">License</a></li>
        </ul>
      </div>

    </nav>

  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <p>
      © {year} EdgeParse · Built by
      <a href="https://elitizon.com/" target="_blank" rel="noopener noreferrer">Elitizon</a>
       · Apache 2.0
    </p>
    <p class="footer-bottom-links">
      <a href="https://github.com/raphaelmansuy/edgeparse/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">License</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/raphaelmansuy/edgeparse" target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--ep-card-border, #E5E7EB);
    background: var(--sl-color-bg, #fff);
    color: var(--ep-color-muted, #6B7280);
    font-size: 0.875rem;
    padding: 0;
    margin-top: 0;
  }

  .footer-inner {
    max-width: 1152px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 2rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: start;
  }

  /* Brand */
  .footer-brand {
    max-width: 280px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    margin-bottom: 0.75rem;
  }

  .footer-logo-text {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ep-text-primary, #111827);
    letter-spacing: -0.02em;
  }

  .footer-logo-accent {
    color: #6366f1;
  }

  .footer-logo-icon {
    flex-shrink: 0;
  }

  .footer-tagline {
    font-size: 0.8125rem;
    color: var(--ep-color-muted, #6B7280);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .footer-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 0.3rem;
    border: 1px solid var(--ep-card-border, #E5E7EB);
    color: var(--ep-text-secondary, #4B5563);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .footer-badge:hover {
    border-color: var(--sl-color-accent, #4F46E5);
    color: var(--sl-color-accent, #4F46E5);
  }

  .footer-badge--accent {
    border-color: var(--sl-color-accent, #4F46E5);
    color: var(--sl-color-accent, #4F46E5);
  }

  .footer-badge--green {
    border-color: var(--ep-color-nodejs, #15803D);
    color: var(--ep-color-nodejs, #15803D);
  }

  /* Columns nav */
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(4, max-content);
    gap: 2.5rem;
  }

  .footer-col-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ep-text-primary, #111827);
    margin-bottom: 0.875rem;
  }

  .footer-col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col-links a {
    color: var(--ep-color-muted, #6B7280);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .footer-col-links a:hover {
    color: var(--sl-color-accent, #4F46E5);
  }

  /* Bottom bar */
  .footer-bottom {
    max-width: 1152px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--ep-card-border, #E5E7EB);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ep-color-muted, #6B7280);
  }

  .footer-bottom p { margin: 0; }

  .footer-bottom a {
    color: var(--ep-color-muted, #6B7280);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-bottom a:hover {
    color: var(--sl-color-accent, #4F46E5);
  }

  .footer-bottom-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-brand {
      max-width: 100%;
    }
  }

  @media (max-width: 540px) {
    .footer-inner {
      padding: 2.5rem 1rem 1.5rem;
    }

    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .footer-bottom {
      padding: 1rem;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
