{
  "name": "@edgeparse/pdf",
  "version": "0.1.0",
  "description": "High-performance PDF extraction — Rust engine, Node.js interface",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "edgeparse": "./dist/cli.cjs"
  },
  "files": [
    "dist/",
    "npm/",
    "README.md"
  ],
  "optionalDependencies": {
    "@edgeparse/pdf-linux-x64-gnu": "0.1.0",
    "@edgeparse/pdf-linux-arm64-gnu": "0.1.0",
    "@edgeparse/pdf-darwin-x64": "0.1.0",
    "@edgeparse/pdf-darwin-arm64": "0.1.0",
    "@edgeparse/pdf-win32-x64-msvc": "0.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/opendataloader-project/edgeparse.git",
    "directory": "sdks/node"
  },
  "keywords": ["pdf", "extraction", "markdown", "json", "rag", "llm", "rust"],
  "scripts": {
    "build:native": "cargo build --manifest-path ../../crates/edgeparse-node/Cargo.toml --release",
    "build:ts": "npx tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "build": "npm run build:native && npm run build:ts",
    "test": "npx vitest run"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
