# ─── Wasmtime Runner ────────────────────────────────────────────────────────
# Greg's AI coding buddy:
#   Wasmtime — the Bytecode Alliance reference runtime.
#   Cranelift JIT, full WASI Preview1 + Preview2, production-grade.
#   The runtime that sets the standard. If it works here, it works anywhere.
#
#   docker build -f tests/wasm-runtimes/Dockerfile.runner.wasmtime \
#                -t edgeparse-wasi-wasmtime .
# ─────────────────────────────────────────────────────────────────────────────

FROM edgeparse-wasi-base

RUN curl -sSf https://wasmtime.dev/install.sh | bash
ENV PATH="/root/.wasmtime/bin:${PATH}"

# Verify installation
RUN wasmtime --version

# Copy pre-built WASM binary (built by Dockerfile.build.wasm)
COPY tests/wasm-runtimes/.build/edgeparse.wasm /test/edgeparse.wasm

CMD ["wasmtime"]
